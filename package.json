{
  "name": "sg-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm build:packages && pnpm build:app2",
    "build:packages": "cd packages/geometry && pnpm run build",
    "build:app2": "cd app2 && pnpm run build",
    "check": "pnpm lint && pnpm fmt:check",
    "format": "pnpm fmt:check",
    "format:fix": "pnpm fmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm run test:packages && pnpm run test:app2",
    "test:packages": "cd packages/geometry && pnpm test",
    "test:app2": "cd app2 && pnpm test",
    "test:watch": "cd packages/geometry && pnpm run test:watch",
    "test:coverage": "cd packages/geometry && pnpm run coverage",
    "type-check": "cd packages/geometry && npx --yes tsc --noEmit && cd ../../app2 && npx --yes tsc --noEmit",
    "type-check:geometry": "cd packages/geometry && npx --yes tsc --noEmit",
    "type-check:app2": "cd app2 && npx tsc --noEmit",
    "type-check:all": "pnpm --parallel type-check",
    "dev": "cd app2 && pnpm run dev",
    "dev:app2": "cd app2 && pnpm run dev",
    "prepare": "pnpm run build",
    "clean": "rm -rf **/node_modules **/dist **/coverage || true"
  },
  "devDependencies": {
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0"
  }
}
